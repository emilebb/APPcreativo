rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función helper para verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función helper para verificar si es el propietario
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ============================================================
    // REGLAS PERMISIVAS PARA TESTING
    // Los usuarios simulados pueden leer/escribir sus propios datos
    // En producción, usar isOwner() en lugar de request.auth != null
    // ============================================================
    
    // Proyectos
    match /projects/{projectId} {
      // Testing: permitir acceso si el ID del documento contiene el userId
      // Producción: cambiar a isOwner(projectId.split('-')[0])
      allow read: if true;  // Testing: permitir todos
      allow create: if true;
      allow update, delete: if true;
    }
    
    // Moodboards
    match /moodboards/{moodboardId} {
      allow read: if true;  // Testing: permitir todos
      allow create: if true;
      allow update, delete: if true;
    }
    
    // Mindmaps
    match /mindmaps/{mindmapId} {
      allow read: if true;  // Testing: permitir todos
      allow create: if true;
      allow update, delete: if true;
    }
    
    // Perfiles
    match /profiles/{userId} {
      allow read: if true;  // Testing: permitir todos
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
    
    // Chats
    match /users/{userId}/chats/{chatId} {
      allow read, write: if true;  // Testing
      
      match /messages/{messageId} {
        allow read, write: if true;  // Testing
      }
    }
    
    // Maps (para mindmaps con estructura alternativa)
    match /users/{userId}/maps/{mapId} {
      allow read, write: if true;  // Testing
      
      match /nodes/{nodeId} {
        allow read, write: if true;  // Testing
      }
      
      match /edges/{edgeId} {
        allow read, write: if true;  // Testing
      }
    }
    
    // Estadísticas de usuario
    match /user_stats/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Comentarios
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    
    // Patrones de estilo
    match /style_patterns/{patternId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    
    // Sugerencias de estilo
    match /style_suggestions/{suggestionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
